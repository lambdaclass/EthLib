/-!
# `Sha256Fast`

SHA-256 with the spec's results (`EthLib.Cryptography.Bls.Sha256.hash`),
computed with the compression function unrolled over eight scalar `UInt32`
registers and the message schedule computed on the fly. The spec keeps the
state and schedule in arrays updated inside `for` loops, which allocates
per round; hash-to-curve runs about twenty compressions per message.
-/

namespace EthLibImpl.Cryptography.Bls.Sha256Fast

@[inline] def rotr (x : UInt32) (n : UInt32) : UInt32 := (x >>> n) ||| (x <<< (32 - n))
@[inline] def bs0 (x : UInt32) : UInt32 := rotr x 2 ^^^ rotr x 13 ^^^ rotr x 22
@[inline] def bs1 (x : UInt32) : UInt32 := rotr x 6 ^^^ rotr x 11 ^^^ rotr x 25
@[inline] def ss0 (x : UInt32) : UInt32 := rotr x 7 ^^^ rotr x 18 ^^^ (x >>> 3)
@[inline] def ss1 (x : UInt32) : UInt32 := rotr x 17 ^^^ rotr x 19 ^^^ (x >>> 10)
@[inline] def ch (x y z : UInt32) : UInt32 := (x &&& y) ^^^ ((~~~x) &&& z)
@[inline] def maj (x y z : UInt32) : UInt32 := (x &&& y) ^^^ (x &&& z) ^^^ (y &&& z)

structure St where
  a : UInt32
  b : UInt32
  c : UInt32
  d : UInt32
  e : UInt32
  f : UInt32
  g : UInt32
  h : UInt32

@[inline] def be32 (b : ByteArray) (off : Nat) : UInt32 :=
  ((b.get! off).toUInt32 <<< 24) ||| ((b.get! (off + 1)).toUInt32 <<< 16) |||
  ((b.get! (off + 2)).toUInt32 <<< 8) ||| (b.get! (off + 3)).toUInt32

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
